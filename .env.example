# PostgreSQL settings used by docker compose. Replace the password outside local development.
POSTGRES_DB=irishrail
POSTGRES_USER=irishrail
POSTGRES_PASSWORD=change-me

# Web host port and worker polling configuration.
WEB_PORT=8000
STATION_CODES=DBATE,MHIDE,GRGRD,HWTHJ,HOWTH,CLSLA,MYNTH,DCDRA,CTARF,CNLLY,TARA,HSTON,PERSE,GCDK,LDWNE,HZLCH,BROCK,DLERY,BRAY,GSTNS
FETCH_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=15
