# Copy to /opt/irish-rail-tracker/.env; chmod 600; never commit the real file.
# Use shell-compatible KEY=value lines: backup.sh also sources this file.
# Use letters/digits/underscores for the database/user and a random hex password
# (openssl rand -hex 32), since Compose builds DATABASE_URL from these values.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_random_hex_password

STATION_CODES=DBATE,MHIDE,GRGRD,HWTHJ,HOWTH,CLSLA,MYNTH,DCDRA,CTARF,CNLLY,TARA,HSTON,PERSE,GCDK,LDWNE,HZLCH,HAZEF,HAZES,BROCK,DLERY,BRAY,GSTNS
FETCH_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=15
# Optional API override; omit this line to use the application's default.
# IRISH_RAIL_API_URL=https://rail-api.example/getStationDataByCodeXML

BACKUP_BUCKET=replace_with_backup_bucket_name
AWS_REGION=replace_with_bucket_region

# Deploy and rollback override this with the full commit SHA.
IMAGE_TAG=latest
# DATABASE_URL is generated by Compose; WEB_PORT is fixed at 80 in production.
